# ==============================================================================
# AASRA Environment Variables Configuration Template
# Copy this file to .env and fill in your API keys before running the application.
# ==============================================================================

# Groq Cloud API Key (for Chatbot & Distress Evaluation LLM)
GROQ_API_KEY=your_groq_api_key_here

# Bolna AI Voice Agent Credentials (for Real-time WebRTC Voice Companion)
BOLNA_AGENT_ID=a7d2ff8b-2794-4d24-bf0d-321943561b4f
BOLNA_API_KEY=your_bolna_api_key_here

# AI Model Configuration
LLM_MODEL=openai/gpt-oss-120b
WHISPER_MODEL=whisper-large-v3

# Server Binding
HOST=127.0.0.1
PORT=8000
AUDIO_SAMPLE_RATE=16000
